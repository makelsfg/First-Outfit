<view class="app theme-{{theme}}">
  <view class="page-container">
    <!-- 加载态 -->
    <view class="loading" wx:if="{{loading}}">正在为你搭配…</view>

    <block wx:else>
      <!-- 天气 Hero -->
      <view class="hero-card">
        <view class="hero-top">
          <view class="hero-city" bindtap="onOpenCitySheet">{{weather.city}}<text class="caret">▾</text></view>
          <view class="hero-refresh" bindtap="onRefresh">⟳ {{updatedAt}}</view>
        </view>
        <view class="hero-main">
          <text class="hero-temp">{{weather.temp}}°</text>
          <view class="hero-weather">
            <text class="hero-icon">{{weather.icon}}</text>
            <text class="hero-text">{{weather.text}}</text>
          </view>
        </view>
        <view class="hero-date">{{dateText}}</view>
      </view>

      <!-- 形象 + 衣柜入口 -->
      <view class="avatar-card">
        <view class="avatar-body">
          <image class="avatar-img" src="{{avatar}}" mode="aspectFit" />
          <view class="avatar-actions">
            <view class="avatar-gear" bindtap="onOpenSettings" aria-label="设置">⚙️</view>
            <view class="avatar-btn" bindtap="onOpenWardrobe">👕 我的衣柜</view>
            <view class="avatar-btn" bindtap="onAddClothing">📷 拍照录入</view>
          </view>
        </view>
      </view>

      <!-- 一句话结论 + meta -->
      <view class="card conclusion-card">
        <text class="summary-text">{{outfit.summary}}</text>
        <view class="meta-row">{{metaText}}</view>
      </view>

      <!-- 时段 / 场合切换 -->
      <view class="tabs-row">
        <view class="slots">
          <view
            class="slot {{slot === item.key ? 'slot-active' : ''}}"
            wx:for="{{slots}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="onSelectSlot"
          >{{item.label}}</view>
        </view>
        <view class="scenes">
          <view
            class="scene {{scene === item.key ? 'scene-active' : ''}}"
            wx:for="{{scenes}}"
            wx:key="key"
            data-key="{{item.key}}"
            bindtap="onSelectScene"
          >{{item.label}}</view>
        </view>
      </view>

      <!-- 今日穿搭建议 -->
      <view class="card">
        <view class="section-title">今日穿搭建议<text class="variant-tag" wx:if="{{outfit.variantLabel}}">{{outfit.variantLabel}}</text></view>
        <view class="outfit-item">
          <text class="outfit-label">上装</text>
          <text class="outfit-value">{{outfit.top}}</text>
        </view>
        <view class="outfit-item" wx:if="{{outfit.coat}}">
          <text class="outfit-label">外套</text>
          <text class="outfit-value">{{outfit.coat}}</text>
        </view>
        <view class="outfit-item" wx:if="{{outfit.inner}}">
          <text class="outfit-label">内搭</text>
          <text class="outfit-value">{{outfit.inner}}</text>
        </view>
        <view class="outfit-item">
          <text class="outfit-label">下装</text>
          <text class="outfit-value">{{outfit.bottom}}</text>
        </view>
        <view class="outfit-item">
          <text class="outfit-label">鞋子</text>
          <text class="outfit-value">{{outfit.shoes}}</text>
        </view>
        <view class="next-btn" wx:if="{{outfits.length > 1}}" bindtap="onNextOutfit">
          换一套（{{outfitIndex + 1}}/{{outfits.length}}）
        </view>
      </view>

      <!-- 推荐理由 -->
      <view class="card">
        <view class="section-title">推荐理由</view>
        <view class="reason-tag">{{outfit.sceneTag}}</view>
        <view class="reason-point" wx:for="{{outfit.reasonPoints}}" wx:key="*this">
          <text class="reason-dot">·</text>
          <text class="reason-text">{{item}}</text>
        </view>
        <text class="disclaimer">以上建议仅供参考，请根据实际情况调整</text>
      </view>

      <!-- 小提醒 -->
      <view class="card" wx:if="{{outfit.tips.length > 0}}">
        <view class="section-title">小提醒</view>
        <view class="tip-item" wx:for="{{outfit.tips}}" wx:key="*this">
          <text class="tip-dot">·</text>
          <text class="tip-text">{{item}}</text>
        </view>
      </view>

    </block>
  </view>

  <!-- 悬浮客服 -->
  <view class="fab" bindtap="onOpenChat">💬</view>

  <!-- 城市选择弹层 -->
  <view class="sheet-mask" wx:if="{{citySheetVisible}}" bindtap="onCloseCitySheet">
    <view class="city-sheet" catchtap="onStopTap">
      <block wx:if="{{sheetLevel === 'province'}}">
        <view class="city-sheet-title">选择城市</view>
        <view class="city-item city-item-auto" bindtap="onUseAutoLocation">自动定位（当前位置）</view>
        <scroll-view scroll-y class="city-list">
          <view
            class="city-item"
            wx:for="{{provinces}}"
            wx:key="name"
            data-index="{{index}}"
            bindtap="onPickProvince"
          >{{item.name}}<text class="city-arrow">›</text></view>
        </scroll-view>
      </block>
      <block wx:else>
        <view class="city-sheet-title city-sheet-back" bindtap="onBackToProvinces">‹ {{activeProvince.name}}</view>
        <scroll-view scroll-y class="city-list">
          <view
            class="city-item {{city && city.adcode === item.adcode ? 'city-item-active' : ''}}"
            wx:for="{{activeProvince.cities}}"
            wx:key="adcode"
            data-adcode="{{item.adcode}}"
            data-name="{{item.name}}"
            bindtap="onSelectCity"
          >{{item.name}}</view>
        </scroll-view>
      </block>
    </view>
  </view>

  <!-- 资料引导弹窗 -->
  <view class="guide-mask" wx:if="{{showProfileGuide}}">
    <view class="guide-card">
      <text class="guide-emoji">✨</text>
      <text class="guide-title">填写基本信息，穿搭更懂你</text>
      <text class="guide-desc">填一下性别和年龄段，首页会为你推荐更贴合的衣服。</text>
      <view class="guide-btn" bindtap="onGoProfile">去填写</view>
      <view class="guide-skip" bindtap="onSkipGuide">跳过</view>
    </view>
  </view>
</view>