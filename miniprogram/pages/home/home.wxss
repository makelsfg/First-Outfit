.loading {
  text-align: center;
  color: var(--text-3);
  padding: 120rpx 0;
  font-size: 28rpx;
}

/* 天气 Hero */
.hero-card {
  background: linear-gradient(135deg, var(--brand-2) 0%, var(--brand) 100%);
  border-radius: 32rpx;
  padding: 32rpx 36rpx 36rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx var(--shadow);
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  opacity: 0.95;
}

.hero-city {
  display: flex;
  align-items: center;
  font-weight: 500;
}

.caret {
  margin-left: 8rpx;
  font-size: 22rpx;
}

.hero-refresh {
  font-size: 24rpx;
  opacity: 0.9;
}

.hero-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.hero-temp {
  font-size: 108rpx;
  font-weight: 700;
  line-height: 1.1;
}

.hero-weather {
  text-align: center;
}

.hero-icon {
  font-size: 64rpx;
  display: block;
}

.hero-text {
  font-size: 26rpx;
  opacity: 0.95;
}

.hero-date {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

/* 形象 + 衣柜入口 */
.avatar-card {
  background: var(--brand-soft);
  border-radius: 28rpx;
  padding: 16rpx 28rpx 28rpx;
  margin-bottom: 24rpx;
}

.avatar-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.avatar-img {
  width: 230rpx;
  height: 290rpx;
}

.avatar-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

/* 右上角齿轮：进设置页 */
.avatar-gear {
  width: 66rpx;
  height: 66rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  line-height: 1;
  border-radius: 50%;
  background: var(--card);
  box-shadow: 0 6rpx 18rpx var(--shadow);
}

.avatar-btn {
  background: var(--card);
  color: var(--text);
  font-size: 27rpx;
  border-radius: 40rpx;
  padding: 14rpx 30rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 18rpx var(--shadow);
}

.avatar-btn:last-child {
  margin-bottom: 0;
}

/* 卡片内区块 */
.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 20rpx;
}

/* 一句话结论 */
.conclusion-card {
  padding: 32rpx;
}

.summary-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.5;
  display: block;
}

.meta-row {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--text-3);
}

/* 时段 / 场合切换 */
.tabs-row {
  margin-bottom: 24rpx;
}

.slots {
  display: flex;
  background: var(--card);
  border-radius: 44rpx;
  padding: 6rpx;
  box-shadow: 0 8rpx 24rpx var(--shadow);
}

.slot {
  flex: 1;
  text-align: center;
  line-height: 68rpx;
  font-size: 28rpx;
  color: var(--text-2);
  border-radius: 38rpx;
}

.slot-active {
  background: var(--btn-dark);
  color: #FFFFFF;
  font-weight: 600;
}

.scenes {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.scene {
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  background: var(--card);
  color: var(--text-2);
  font-size: 26rpx;
  margin: 0 16rpx 16rpx 0;
  box-shadow: 0 6rpx 18rpx var(--shadow);
}

.scene-active {
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  color: #FFFFFF;
  font-weight: 600;
}

/* 穿搭建议 */
.variant-tag {
  margin-left: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 20rpx;
  padding: 4rpx 18rpx;
}

.outfit-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--brand-soft);
}

.outfit-item:last-of-type {
  border-bottom: none;
}

.outfit-label {
  width: 100rpx;
  font-size: 26rpx;
  color: var(--text-3);
}

.outfit-value {
  flex: 1;
  font-size: 30rpx;
  color: var(--text);
  font-weight: 500;
}

.next-btn {
  margin-top: 28rpx;
  background: var(--btn-dark);
  color: #FFFFFF;
  border-radius: 44rpx;
  text-align: center;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
}

/* 推荐理由 */
.reason-tag {
  display: inline-block;
  font-size: 22rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 20rpx;
  padding: 8rpx 22rpx;
  margin-bottom: 16rpx;
}

.reason-point {
  display: flex;
  margin-bottom: 14rpx;
}

.reason-dot {
  color: var(--brand);
  font-size: 28rpx;
  margin-right: 12rpx;
}

.reason-text {
  flex: 1;
  font-size: 27rpx;
  color: var(--text-2);
  line-height: 1.7;
}

.disclaimer {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

/* 小提醒 */
.tip-item {
  display: flex;
  margin-bottom: 12rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-dot {
  color: var(--brand);
  font-size: 28rpx;
  margin-right: 12rpx;
}

.tip-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-2);
}

/* 打卡按钮 */
.checkin-btn {
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  color: #FFFFFF;
  border-radius: 44rpx;
  text-align: center;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin: 24rpx 0 8rpx;
  box-shadow: 0 8rpx 24rpx var(--shadow);
}

.checkin-btn-done {
  background: #E5E7EB;
  color: var(--text-3);
  box-shadow: none;
}

/* 悬浮客服 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: 60rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  color: #FFFFFF;
  font-size: 44rpx;
  line-height: 96rpx;
  text-align: center;
  box-shadow: 0 12rpx 32rpx var(--shadow);
  z-index: 900;
}

/* 弹窗1：上传成功提示 */
.toast-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.toast-card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 40rpx;
  max-width: 560rpx;
  width: 76%;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
  opacity: 1;
  transition: opacity 0.4s ease;
}

.toast-fading {
  opacity: 0;
}

.toast-text {
  font-size: 28rpx;
  color: var(--text);
  line-height: 1.6;
  text-align: center;
}

/* 弹窗2：鼓励语 */
.encourage-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1001;
}

.encourage-card {
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  max-width: 560rpx;
  width: 80%;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 48rpx var(--shadow);
  animation: encourage-pop 0.3s ease;
}

@keyframes encourage-pop {
  from {
    transform: scale(0.8);
    opacity: 0.5;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.encourage-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 16rpx;
}

.encourage-content {
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1.6;
  text-align: center;
  margin-bottom: 32rpx;
}

.encourage-btn {
  background: var(--card);
  color: var(--brand);
  border-radius: 40rpx;
  padding: 16rpx 80rpx;
  font-size: 28rpx;
  font-weight: 600;
}

/* 城市选择弹层 */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 1002;
}

.city-sheet {
  width: 100%;
  background: var(--card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.city-sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  text-align: center;
  margin-bottom: 24rpx;
}

.city-list {
  max-height: 640rpx;
}

.city-item {
  position: relative;
  text-align: center;
  font-size: 30rpx;
  color: var(--text);
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--brand-soft);
}

.city-item-active {
  color: var(--brand);
  font-weight: 600;
}

.city-item-auto {
  color: var(--brand);
  font-weight: 500;
  border-bottom: none;
}

.city-arrow {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-3);
  font-size: 32rpx;
}

.city-sheet-back {
  text-align: left;
  color: var(--brand);
}

/* 资料引导弹窗 */
.guide-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1003;
}

.guide-card {
  width: 78%;
  background: var(--card);
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 16rpx 48rpx var(--shadow);
}

.guide-emoji {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.guide-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 20rpx;
}

.guide-desc {
  font-size: 27rpx;
  color: var(--text-2);
  line-height: 1.7;
  text-align: center;
  margin-bottom: 40rpx;
}

.guide-btn {
  width: 100%;
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  color: #FFFFFF;
  border-radius: 44rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.guide-skip {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--text-3);
  padding: 8rpx 40rpx;
}