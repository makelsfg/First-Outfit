<view class="page-container">
  <!-- 个人信息 -->
  <view class="card">
    <view class="profile-header">
      <view class="section-title">个人信息</view>
      <view class="edit-btn" bindtap="onHeaderBtnTap">{{isEditing ? '保存' : '编辑'}}</view>
    </view>

    <!-- 查看模式 -->
    <block wx:if="{{!isEditing}}">
      <view class="info-item">
        <text class="info-label">昵称</text>
        <text class="info-value">{{nickname || '未填写'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">年龄</text>
        <text class="info-value">{{age || '未填写'}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">性别</text>
        <text class="info-value">{{gender || '未填写'}}</text>
      </view>
    </block>

    <!-- 编辑模式 -->
    <block wx:else>
      <view class="form-item">
        <text class="form-label">昵称</text>
        <input
          class="form-input"
          value="{{nickname}}"
          placeholder="怎么称呼你"
          bindinput="onNicknameInput"
        />
      </view>
      <view class="form-item">
        <text class="form-label">年龄</text>
        <input
          class="form-input"
          value="{{age}}"
          type="number"
          placeholder="你的年龄"
          bindinput="onAgeInput"
        />
      </view>
      <view class="form-item form-item-gender">
        <text class="form-label">性别</text>
        <view class="gender-group">
          <view
            class="gender-tag {{gender === item ? 'gender-tag-active' : ''}}"
            wx:for="{{genders}}"
            wx:key="*this"
            data-value="{{item}}"
            bindtap="onGenderTap"
          >{{item}}</view>
        </view>
      </view>
    </block>
  </view>

  <!-- 风采库入口 -->
  <view class="card gallery-entry" bindtap="onGoGallery">
    <text class="gallery-entry-icon">📁</text>
    <text class="gallery-entry-text">个人每日风采库</text>
    <text class="gallery-entry-days">已打卡 {{checkinDays}} 天</text>
  </view>

  <!-- 鼓励语 -->
  <view class="encourage-card">
    <text class="encourage-text">穿衣搭配没有想象中那么难。我曾经也不会，但慢慢就学会了。</text>
  </view>

  <!-- 反馈 -->
  <view class="card">
    <view class="section-title">给我一点反馈</view>
    <textarea
      class="feedback-input"
      value="{{feedback}}"
      placeholder="哪里觉得好用，哪里还能更好？"
      maxlength="200"
      bindinput="onFeedbackInput"
    />
    <button class="btn-primary save-btn" bindtap="onSubmitFeedback">提交反馈</button>
  </view>
</view>
