<view class="page-container">
  <!-- 搜索框 -->
  <view class="search-bar">
    <input
      class="search-input"
      value="{{query}}"
      placeholder="这个季节穿啥衣服"
      bindinput="onInput"
      confirm-type="search"
      bindconfirm="onSearch"
    />
    <button class="search-btn" bindtap="onSearch">搜索</button>
  </view>

  <!-- 历史记录 -->
  <view class="card history-card" wx:if="{{history.length > 0}}">
    <view class="history-title">历史记录</view>
    <view
      class="history-item"
      wx:for="{{history}}"
      wx:key="time"
      data-index="{{index}}"
      bindtap="onToggleHistory"
    >
      <view class="history-head">
        <text class="history-question">{{item.question}}</text>
        <text class="history-time">{{item.time}}</text>
      </view>
      <view class="history-answer" wx:if="{{expandedIndex === index}}">{{item.answer}}</view>
    </view>
    <view class="clear-btn" bindtap="onClearHistory">清空历史</view>
  </view>

  <!-- 历史为空 -->
  <view class="history-empty" wx:if="{{history.length === 0}}">
    <text>还没有搜索记录</text>
  </view>

  <!-- 加载态 -->
  <view class="loading" wx:if="{{loading}}">正在为你解答…</view>

  <!-- 回答卡片 -->
  <view class="card answer-card" wx:if="{{!loading && hasSearched}}">
    <view class="answer-title">为你解答</view>
    <text class="answer-text" user-select>{{answer}}</text>
  </view>
</view>
