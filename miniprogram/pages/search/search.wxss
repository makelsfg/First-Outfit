.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  background: #FFFFFF;
  border-radius: 44rpx;
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  height: 80rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.08);
}

.search-btn {
  margin-left: 16rpx;
  background: linear-gradient(135deg, #F59E0B, #FB923C);
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 28rpx;
  padding: 0 40rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.search-btn::after {
  border: none;
}

.loading {
  text-align: center;
  color: #9CA3AF;
  padding: 120rpx 0;
  font-size: 28rpx;
}

.context-hint {
  display: inline-block;
  font-size: 22rpx;
  color: #F59E0B;
  background: #FFF4EC;
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  margin-bottom: 20rpx;
}

.answer-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 20rpx;
}

.answer-text {
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 历史记录 */
.history-card {
  margin-bottom: 24rpx;
}

.history-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 8rpx;
}

.history-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #FFF4EC;
}

.history-item:last-of-type {
  border-bottom: none;
}

.history-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.history-question {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2937;
  margin-right: 16rpx;
}

.history-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #9CA3AF;
}

.history-answer {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.7;
  white-space: pre-wrap;
}

.clear-btn {
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #9CA3AF;
  padding: 12rpx 0;
}

.history-empty {
  text-align: center;
  color: #9CA3AF;
  font-size: 28rpx;
  padding: 48rpx 0;
}
