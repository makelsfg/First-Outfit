.photo-box {
  height: 420rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: var(--brand-soft);
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 18rpx var(--shadow);
}

.photo-img {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-holder {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.photo-plus {
  font-size: 72rpx;
  margin-bottom: 12rpx;
}

.photo-hint {
  font-size: 26rpx;
  color: var(--brand);
}

.card {
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 600;
  margin-bottom: 18rpx;
}

.field-tip {
  font-size: 22rpx;
  color: var(--text-3);
  font-weight: 400;
}

.input {
  height: 84rpx;
  font-size: 28rpx;
  color: var(--text);
  background: var(--bg);
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  color: var(--text);
  background: var(--bg);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  padding: 12rpx 30rpx;
  border-radius: 36rpx;
  background: var(--brand-soft);
  color: var(--text-2);
  font-size: 27rpx;
  margin: 0 18rpx 18rpx 0;
}

.chip-active {
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  color: #FFFFFF;
  font-weight: 600;
}

.save-btn {
  width: 100%;
  margin-top: 8rpx;
}