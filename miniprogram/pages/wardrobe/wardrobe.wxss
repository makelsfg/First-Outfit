.search-bar {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: 44rpx;
  padding: 0 28rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 18rpx var(--shadow);
}

.search-icon {
  font-size: 30rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}

.cat-tabs {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.cat-tab {
  font-size: 28rpx;
  color: var(--text-2);
  padding: 12rpx 4rpx;
  margin-right: 36rpx;
  border-bottom: 4rpx solid transparent;
}

.cat-active {
  color: var(--brand);
  font-weight: 600;
  border-bottom-color: var(--brand);
}

.count-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 0 24rpx;
}

.count-text {
  font-size: 26rpx;
  color: var(--text-2);
}

.add-pill {
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 600;
  border-radius: 36rpx;
  padding: 12rpx 32rpx;
  box-shadow: 0 6rpx 18rpx var(--shadow);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.item {
  width: 48%;
  background: var(--card);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 18rpx var(--shadow);
}

.item-img-wrap {
  position: relative;
  width: 100%;
  height: 320rpx;
}

.item-img {
  width: 100%;
  height: 100%;
  display: block;
  background: var(--brand-soft);
}

.item-img-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  background: var(--brand-soft);
}

.cat-tag {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #FFFFFF;
  font-size: 22rpx;
  border-radius: 20rpx;
  padding: 4rpx 18rpx;
}

.item-del {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  color: #FFFFFF;
  font-size: 26rpx;
}

.item-body {
  padding: 16rpx 20rpx 20rpx;
}

.item-name {
  font-size: 27rpx;
  color: var(--text);
  font-weight: 500;
  margin-bottom: 10rpx;
}

.item-tags {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  font-size: 21rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 18rpx;
  padding: 3rpx 16rpx;
  margin: 0 10rpx 8rpx 0;
}

.item-hint {
  font-size: 20rpx;
  color: var(--text-3);
  line-height: 1.5;
}

.empty {
  padding: 140rpx 40rpx;
  text-align: center;
}

.empty-text {
  display: block;
  font-size: 30rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
}

.empty-sub {
  display: block;
  font-size: 25rpx;
  color: var(--text-3);
}